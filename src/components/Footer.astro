---
import site from '../data/settings/site.json';
---
<footer><div class="container foot"><div><strong>{site.name}</strong><p>{site.slogan}</p></div><div class="right">{site.copyright}</div></div></footer>
<style>footer{border-top:1px solid var(--line);padding:40px 0 52px;margin-top:50px}.foot{display:flex;justify-content:space-between;gap:30px;color:var(--muted);font-size:13px}.foot strong{color:var(--text);font-size:16px}.foot p{max-width:520px}.right{text-align:right}@media(max-width:700px){.foot{display:block}.right{text-align:left;margin-top:24px}}</style>

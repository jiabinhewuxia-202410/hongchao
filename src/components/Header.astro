---
import site from '../data/settings/site.json';
const nav=[['资源导航','/resources'],['红潮文库','/library'],['效率工具','/tools'],['文章','/articles'],['关于红潮','/about']];
---
<header class="header">
  <div class="container inner">
    <a class="brand" href="/"><span class="dot"></span>{site.name}</a>
    <nav>{nav.map(([label,href]) => <a href={href}>{label}</a>)}</nav>
    <a class="search" href="/search">搜索</a>
  </div>
</header>
<style>
.header{position:sticky;top:0;z-index:20;background:rgba(246,244,239,.86);backdrop-filter:blur(18px);border-bottom:1px solid rgba(223,221,215,.72)}.inner{height:68px;display:flex;align-items:center;gap:24px}.brand{font-weight:800;letter-spacing:-.03em;font-size:20px;display:flex;align-items:center;gap:9px}.dot{width:11px;height:11px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 5px var(--accent-soft)}nav{display:flex;gap:24px;margin-left:auto}nav a{font-size:14px;color:var(--muted)}nav a:hover{color:var(--text)}.search{font-size:14px;border:1px solid var(--line);border-radius:999px;padding:8px 13px;background:#fff}@media(max-width:760px){nav{display:none}.search{margin-left:auto}}
</style>

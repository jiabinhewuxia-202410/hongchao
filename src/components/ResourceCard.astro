---
const { entry }=Astro.props; const d=entry.data;
---
<a class="card resource" href={`/resources/${entry.id}`}><div class="top"><div class="icon">{d.title.slice(0,1)}</div>{d.featured&&<span class="feature">精选</span>}</div><h3>{d.title}</h3><p>{d.summary}</p><div class="meta"><span>{d.category}</span><span>↗</span></div></a>
<style>.resource{display:block}.top{display:flex;justify-content:space-between;align-items:center}.icon{width:38px;height:38px;border-radius:12px;background:var(--surface-2);display:grid;place-items:center;font-weight:800}.feature{font-size:11px;color:var(--accent);background:var(--accent-soft);padding:5px 8px;border-radius:999px}h3{margin:20px 0 8px;font-size:18px}p{margin:0;color:var(--muted);line-height:1.7;font-size:14px}.meta{margin-top:22px;display:flex;justify-content:space-between;color:var(--muted);font-size:12px}</style>

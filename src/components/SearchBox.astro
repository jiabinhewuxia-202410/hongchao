---
const { compact=false, keywords=[] }=Astro.props;
---
<div class:list={["search-wrap", compact && "compact"]} data-searchbox>
  <form action="/search" method="get" class="search-form">
    <span>⌕</span><input name="q" type="search" placeholder="搜索资料、工具、文章、制度……" autocomplete="off"/><button type="submit">搜索</button>
  </form>
  {keywords.length>0 && <div class="keywords">{keywords.map((k:string)=><a href={`/search?q=${encodeURIComponent(k)}`}>{k}</a>)}</div>}
</div>
<style>.search-wrap{margin-top:34px}.search-form{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--line);border-radius:20px;padding:9px 10px 9px 17px;box-shadow:0 16px 50px rgba(31,28,24,.08);max-width:760px}.search-form span{font-size:24px;color:var(--muted)}input{flex:1;border:0;outline:0;background:transparent;font-size:16px;min-width:0;padding:8px 0}.search-form button{border:0;background:var(--text);color:#fff;border-radius:13px;padding:11px 18px;cursor:pointer}.keywords{margin-top:14px;display:flex;gap:8px;flex-wrap:wrap}.keywords a{font-size:12px;padding:7px 10px;background:rgba(255,255,255,.72);border:1px solid var(--line);border-radius:999px;color:var(--muted)}.compact{margin-top:0}</style>

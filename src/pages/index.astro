---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchBox from '../components/SearchBox.astro';
import ResourceCard from '../components/ResourceCard.astro';
import ContentCard from '../components/ContentCard.astro';
import site from '../data/settings/site.json';
import home from '../data/settings/home.json';

const resources=(await getCollection('resources')).sort((a,b)=>a.data.order-b.data.order);
const library=(await getCollection('library')).sort((a,b)=>a.data.order-b.data.order);
const articles=(await getCollection('articles')).sort((a,b)=>+new Date(b.data.publishedAt)-+new Date(a.data.publishedAt));
const topics=(await getCollection('topics')).sort((a,b)=>a.data.order-b.data.order);
const modules=[...home.modules].filter(m=>m.visible).sort((a,b)=>a.order-b.order);
const moduleMap=Object.fromEntries(home.modules.map(m=>[m.id,m]));
const homeResources=resources.filter(x=>x.data.home||x.data.featured).slice(0,6);
const homeLibrary=library.filter(x=>x.data.home||x.data.featured).slice(0,6);
const homeArticles=articles.filter(x=>x.data.home||x.data.featured).slice(0,6);
const homeTopics=topics.filter(x=>x.data.home).slice(0,3);
---
<BaseLayout title={site.name} description={site.slogan}><Header />
<main>
{modules.map((m)=>{
  if(m.id==='hero') return <section class="hero"><div class="container"><div class="eyebrow">HONGCHAO CHAIN · 2.0</div><h1>{site.heroTitle}</h1><p>{site.heroSubtitle}</p><SearchBox keywords={home.hotKeywords}/><div class="trust"><span>真实经验</span><span>持续沉淀</span><span>同行连接</span><span>长期主义</span></div></div></section>;
  if(m.id==='resources') return <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">RESOURCE</div><h2 class="section-title">{m.title}</h2><div class="section-sub">{m.subtitle}</div></div><a class="btn" href="/resources">全部资源 →</a></div><div class="grid">{homeResources.map(entry=><ResourceCard entry={entry}/>)}</div></div></section>;
  if(m.id==='library') return <section class="section tone"><div class="container"><div class="section-head"><div><div class="eyebrow">LIBRARY</div><h2 class="section-title">{m.title}</h2><div class="section-sub">{m.subtitle}</div></div><a class="btn" href="/library">进入文库 →</a></div><div class="grid">{homeLibrary.map(entry=><ContentCard entry={entry} type="library"/>)}</div></div></section>;
  if(m.id==='tools') return <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">TOOLS</div><h2 class="section-title">{m.title}</h2><div class="section-sub">{m.subtitle}</div></div><a class="btn" href="/tools">全部工具 →</a></div><div class="tools"><a href="/search?q=AI办公"><b>AI 办公工具</b><span>写作、搜索、自动化</span></a><a href="/search?q=模板"><b>常用模板</b><span>Word、PPT、Excel</span></a><a href="/search?q=党务"><b>党务工具箱</b><span>SOP、制度、案例</span></a></div></div></section>;
  if(m.id==='topics') return <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">TOPICS</div><h2 class="section-title">{m.title}</h2><div class="section-sub">{m.subtitle}</div></div></div><div class="grid">{homeTopics.map(entry=><ContentCard entry={entry} type="topic"/>)}</div></div></section>;
  if(m.id==='articles') return <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">JOURNAL</div><h2 class="section-title">{m.title}</h2><div class="section-sub">{m.subtitle}</div></div><a class="btn" href="/articles">更多文章 →</a></div><div class="grid">{homeArticles.map(entry=><ContentCard entry={entry} type="article"/>)}</div></div></section>;
  if(m.id==='about') return <section class="section about"><div class="container about-in"><div><div class="eyebrow">ABOUT HONGCHAO</div><h2>{m.title}</h2></div><div><p>{site.slogan}</p><div class="values"><span>真实经验</span><span>持续沉淀</span><span>同行连接</span><span>长期主义</span></div><a href="/about">了解红潮 →</a></div></div></section>;
  return null;
})}
</main><Footer /></BaseLayout>
<style>.hero{padding:108px 0 72px;min-height:610px;display:flex;align-items:center}.hero h1{font-size:clamp(46px,7.5vw,88px);line-height:1.04;letter-spacing:-.055em;max-width:970px;margin:18px 0 20px}.hero>div>p{font-size:19px;color:var(--muted)}.trust{margin-top:46px;border-top:1px solid var(--line);padding-top:18px;display:grid;grid-template-columns:repeat(4,1fr);max-width:760px;color:var(--muted);font-size:12px}.tone{background:rgba(255,255,255,.38);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.tools{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.tools a{padding:28px;border-radius:20px;background:#1d1d1b;color:#fff;min-height:155px;display:flex;flex-direction:column;justify-content:space-between}.tools b{font-size:20px}.tools span{font-size:13px;color:#bab8b1}.about{padding-bottom:100px}.about-in{border-radius:32px;background:#1e1e1c;color:#fff;padding:50px;display:grid;grid-template-columns:1fr 1fr;gap:80px}.about h2{font-size:48px;margin:12px 0}.about p{font-size:19px;line-height:1.8;color:#d1cec6}.about a{display:inline-block;margin-top:28px}.values{display:flex;flex-wrap:wrap;gap:9px}.values span{font-size:12px;border:1px solid #4b4a46;padding:7px 10px;border-radius:999px;color:#d4d1c9}@media(max-width:820px){.hero{padding:76px 0 48px;min-height:auto}.hero h1{font-size:48px}.trust{grid-template-columns:repeat(2,1fr);gap:15px}.tools{grid-template-columns:1fr}.about-in{grid-template-columns:1fr;gap:18px;padding:30px}.about h2{font-size:36px}}</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';import SearchBox from '../../components/SearchBox.astro';
---
<BaseLayout title="搜索"><Header/><main class="container page"><div class="eyebrow">SEARCH</div><h1>搜索红潮链</h1><SearchBox compact/><div id="result-info" class="info"></div><div id="results" class="results"></div></main><Footer/></BaseLayout>
<script>
const params=new URLSearchParams(location.search);const q=(params.get('q')||'').trim();const input=document.querySelector('input[name="q"]');if(input) input.value=q;const box=document.querySelector('#results');const info=document.querySelector('#result-info');
const escapeHtml=s=>s.replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
if(q){fetch('/search-index.json').then(r=>r.json()).then(items=>{const key=q.toLowerCase();const matches=items.filter(x=>[x.title,x.summary,...(x.tags||[])].join(' ').toLowerCase().includes(key));info.textContent=`找到 ${matches.length} 条与“${q}”相关的内容`;box.innerHTML=matches.map(x=>`<a class="result" href="${x.href}"><span>${escapeHtml(x.type)}</span><h3>${escapeHtml(x.title)}</h3><p>${escapeHtml(x.summary)}</p></a>`).join('')||'<div class="empty">暂时没有找到。换一个更短的关键词试试。</div>';});}else{info.textContent='输入一个关键词开始搜索。'}
</script>
<style>.page{padding:80px 0;max-width:900px}.page h1{font-size:58px}.info{margin:36px 0 16px;color:var(--muted);font-size:13px}.results{display:grid;gap:10px}.result{display:block;padding:22px 0;border-bottom:1px solid var(--line)}.result span{font-size:11px;color:var(--accent)}.result h3{margin:8px 0;font-size:20px}.result p{margin:0;color:var(--muted);line-height:1.7}.empty{padding:34px 0;color:var(--muted)}</style>
